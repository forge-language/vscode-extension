{
  "name": "forge-vscode",
  "displayName": "Forge",
  "description": "Forge language support \u2014 syntax highlighting and LSP",
  "version": "0.1.0",
  "publisher": "forge-language",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/forge-language/vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:forge"
  ],
  "contributes": {
    "languages": [
      {
        "id": "forge",
        "aliases": [
          "Forge",
          "forge"
        ],
        "extensions": [
          ".fg"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "forge",
        "scopeName": "source.forge",
        "path": "./syntaxes/forge.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.path": {
          "type": "string",
          "default": "",
          "description": "Path to the forge compiler binary."
        },
        "forge.forgeRoot": {
          "type": "string",
          "default": "",
          "description": "Forge project root (--forge-root)."
        },
        "forge.libDir": {
          "type": "string",
          "default": "",
          "description": "Directory with libforge_*.a (--lib-dir)."
        },
        "forge.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra -I paths for module resolution."
        },
        "forge.serverMode": {
          "type": "string",
          "enum": [
            "native",
            "typescript"
          ],
          "default": "native",
          "description": "Language server implementation. Install and configure the selected server separately."
        },
        "forge.lspPath": {
          "type": "string",
          "default": "",
          "description": "Native forge-lsp executable path or command name. Defaults to forge-lsp on PATH."
        },
        "forge.serverModule": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the separately built TypeScript language server out/server.js. Required in typescript mode."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "watch": "tsc -p tsconfig.json --watch",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.2"
  }
}
